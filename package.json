{
  "name": "snap-layer",
  "private": true,
  "version": "0.4.1",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --app",
    "build": "tsc --noEmit && vite build --app",
    "lint": "biome check .",
    "format": "biome check --write *",
    "test": "vitest",
    "test:cov": "vitest --coverage",
    "prepare": "prek install"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@j178/prek": "^0.5.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^28.1.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.20.0"
